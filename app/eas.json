{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "preview": {
      "distribution": "internal",
      "android": { "buildType": "apk" },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://apiagendamento.monex.net.br/api",
        "EXPO_PUBLIC_PRIVACY_URL": "https://apiagendamento.monex.net.br/privacidade"
      }
    },
    "production": {
      "autoIncrement": true,
      "android": { "buildType": "app-bundle" },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://apiagendamento.monex.net.br/api",
        "EXPO_PUBLIC_PRIVACY_URL": "https://apiagendamento.monex.net.br/privacidade"
      }
    }
  }
}
